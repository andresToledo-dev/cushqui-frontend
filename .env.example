# El navegador llama a /api/v1 y Next lo reenvía a BACKEND_URL (proxy). Así no hace falta CORS.
#
# Desarrollo local: no hace falta nada (por defecto http://localhost:3000).
# BACKEND_URL=http://localhost:3000
#
# Producción (variable del proyecto de Vercel, entorno Production):
# BACKEND_URL=https://cushqui-backend.vercel.app
#
# Opcional: llamar al backend directamente, sin proxy. Requiere que el backend
# permita el dominio del frontend en CORS_ORIGINS.
# NEXT_PUBLIC_API_URL=https://cushqui-backend.vercel.app/api/v1
