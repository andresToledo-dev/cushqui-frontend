# Desarrollo local: deja NEXT_PUBLIC_API_URL sin definir.
# El navegador llama a /api/v1 y Next lo reenvía a BACKEND_URL (por defecto http://localhost:3000).
# BACKEND_URL=http://localhost:3000

# Producción (variable de Vercel, entorno Production): URL pública del backend.
# El navegador llama directamente a esta URL; el backend debe permitir el dominio de Vercel en CORS.
# NEXT_PUBLIC_API_URL=https://api.ejemplo.com/api/v1
